{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestPlanState",
  "description": "Расширение agent-state-schema.json для тестовых планов gigatest. Использует $ref/allOf для композиции с base-схемой.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    { "$ref": "./agent-state-schema.json#" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_plan"],
      "properties": {
        "test_plan": {
          "type": "object",
          "description": "Тестово-специфичные метаданные плана",
          "additionalProperties": false,
          "required": ["target_stack", "test_framework"],
          "properties": {
            "target_stack": {
              "type": "string",
              "description": "Целевой стек проекта",
              "enum": ["react", "java", "js-ts", "multi-stack"]
            },
            "test_framework": {
              "type": "string",
              "description": "Используемый тестовый фреймворк",
              "enum": ["jest", "vitest", "junit", "testng", "pytest", "mocha", "unknown"]
            },
            "context_overlay": {
              "type": "string",
              "description": "Какой testing overlay используется",
              "enum": ["react-testing.md", "java-testing.md", "js-ts-testing.md", ""]
            },
            "coverage_tool": {
              "type": "string",
              "description": "Инструмент измерения покрытия (например, jest --coverage, jacoco)"
            },
            "audit_summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "total_targets": {"type": "integer"},
                "full_coverage": {"type": "integer"},
                "partial_coverage": {"type": "integer"},
                "invalid_coverage": {"type": "integer"},
                "no_coverage": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "quality_gate_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["interaction", "async", "states", "edge_cases", "error_handling", "branch_coverage", "naming", "no_duplication", "mocking_discipline", "custom"],
          "description": "Category of quality requirement"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description (e.g. 'Must test loading/error/success states')"
        },
        "priority": {
          "type": "string",
          "enum": ["required", "recommended"],
          "default": "required",
          "description": "Whether this gate must pass or is a nice-to-have"
        },
        "satisfied": {
          "type": "boolean",
          "description": "Whether this gate has been verified as satisfied. Set by test-implementation or test-review."
        }
      }
    }
  }
}